# Required only when overriding the Host-provided external Project Home.
# Use an absolute path outside the read-only Plugin installation.
CONTENT_OPS_HOME=

# Production defaults. Official Lark CLI OAuth is the ordinary Feishu path.
CONTENT_OPS_RUNTIME_MODE=PRODUCTION
CONTENT_OPS_WORKSPACE_ADAPTER=lark-cli
CONTENT_OPS_RENDERER=playwright-html-css

# Optional managed Chromium cache override. Installed Plugins normally use Plugin Data.
CONTENT_OPS_PLAYWRIGHT_BROWSERS_PATH=

# Legacy enterprise-app credentials are optional process secrets for the gated
# Feishu OpenAPI adapter. Do not store real values in repository files.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_PARENT_FOLDER_TOKEN=
FEISHU_TEST_PARENT_FOLDER_TOKEN=
CONTENT_OPS_ENABLE_LIVE_FEISHU=0
