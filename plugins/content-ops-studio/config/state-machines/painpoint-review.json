{
  "machine": "painpoint-review",
  "version": "1.0.0",
  "states": [
    "PAINPOINT_PENDING",
    "PAINPOINT_CONFIRMED",
    "PAINPOINT_REVISION_REQUIRED",
    "PAINPOINT_REJECTED"
  ],
  "initialStates": ["PAINPOINT_PENDING"],
  "terminalStates": ["PAINPOINT_REJECTED"],
