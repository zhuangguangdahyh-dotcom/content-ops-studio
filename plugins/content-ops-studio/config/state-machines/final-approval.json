      "requiredContext": ["content_version"],
      "invalidates": [],
      "description": "FINAL_APPROVAL_PENDING to FINAL_APPROVAL_APPROVED"
    },
    {
      "from": "FINAL_APPROVAL_PENDING",
      "to": "FINAL_REVISION_REQUIRED",
      "trigger": "REQUEST_FINAL_REVISION",
      "ownerSkill": "content-studio-router",
      "requiresApprovalGate": null,
      "requiredContext": [],
      "invalidates": [],
      "description": "FINAL_APPROVAL_PENDING to FINAL_REVISION_REQUIRED"
    },
    {
      "from": "FINAL_REVISION_REQUIRED",
      "to": "FINAL_APPROVAL_PENDING",
      "trigger": "RESUBMIT_FINAL_VERSION",
      "ownerSkill": "content-finalization",
      "requiresApprovalGate": null,
      "requiredContext": ["auto_qa_passed"],
      "invalidates": [],
      "description": "FINAL_REVISION_REQUIRED to FINAL_APPROVAL_PENDING"
    }
  ]
