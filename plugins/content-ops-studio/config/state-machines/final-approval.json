      "ownerSkill": "content-finalization",
      "requiresApprovalGate": null,
      "requiredContext": [
        "image_status",
        "generated_page_count",
        "expected_page_count",
        "auto_qa_passed"
      ],
      "invalidates": [],
      "description": "FINAL_NOT_SUBMITTED to FINAL_APPROVAL_PENDING"
    },
    {
      "from": "FINAL_APPROVAL_PENDING",
      "to": "FINAL_APPROVAL_APPROVED",
