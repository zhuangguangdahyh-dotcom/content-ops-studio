{
  "policy_version": "1.0.0",
  "renderer_id": "PLAYWRIGHT_HTML_CSS",
  "renderer_version": "1.0.0",
  "runtime_package": "playwright-core",
  "runtime_package_version": "1.62.1",
  "setup_package": "playwright",
  "setup_package_version": "1.62.1",
  "browser_family": "CHROMIUM",
  "browser_install_strategy": "EXPLICIT_MANAGED_SETUP",
  "browser_path_environment_variable": "CONTENT_OPS_PLAYWRIGHT_BROWSERS_PATH",
  "browser_path_policy": "PLUGIN_DATA_OR_EXTERNAL_CACHE",
  "supported_platforms": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64", "win32-x64"],
  "verified_platforms": ["darwin-arm64"],
  "supported_visual_modes": ["EDITORIAL_SERIES"],
  "supported_asset_strategies": [
    "PROGRAMMATIC_GRAPHIC",
    "NO_BACKGROUND_ASSET",
    "PROJECT_ASSET",
    "EVIDENCE_ASSET"
  ],
  "unsupported_asset_strategies": ["GENERATED_BACKGROUND", "REMOTE_URL", "WEB_SCREENSHOT"],
  "canvas_policy": { "width": 1242, "height": 1660, "device_scale_factor": 1 },
  "screenshot_policy": {
    "format": "png",
    "animations": "disabled",
    "caret": "hide",
    "scale": "css",
    "omit_background": false
  },
  "font_policy": "SYSTEM_CJK_STACK_WITH_RESOLUTION_EVIDENCE",
  "network_policy": "BLOCK_ALL",
  "template_policy": "CLOSED_REGISTRY_STRUCTURED_INPUT_ONLY",
  "capability_probe_commands": ["content-ops renderer doctor", "content-ops renderer status"],
  "setup_command_template": "content-ops renderer setup --confirm-renderer-setup",
  "schema_version": "1.0.0"
}
