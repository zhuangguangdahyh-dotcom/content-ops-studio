{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/layout-feasibility-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Layout feasibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout_feasibility_report_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "page_results",
    "total_pages",
    "pass_count",
    "warning_count",
    "blocked_count",
    "overall_status",
    "copy_revision_required",
    "created_at",
    "run_id",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "layout_feasibility_report_id": { "type": "string", "pattern": "^LFR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "page_results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "total_pages": { "type": "integer", "minimum": 1 },
    "pass_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "blocked_count": { "type": "integer", "minimum": 0 },
    "overall_status": { "enum": ["PASS", "WARNING", "BLOCKED"] },
    "copy_revision_required": { "type": "boolean" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "page_role",
        "headline_codepoints",
        "body_codepoints",
        "supporting_codepoints",
        "total_codepoints",
        "estimated_density",
        "estimated_line_count",
        "available_text_regions",
        "typography_token_refs",
        "safe_area_fit",
        "max_lines_fit",
        "hierarchy_fit",
        "contrast_feasibility",
        "overflow_strategy",
        "status",
        "warnings",
        "blocking_reason"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "page_role": { "$ref": "common-definitions.schema.json#/$defs/pageRole" },
        "headline_codepoints": { "type": "integer", "minimum": 0 },
        "body_codepoints": { "type": "integer", "minimum": 0 },
        "supporting_codepoints": { "type": "integer", "minimum": 0 },
        "total_codepoints": { "type": "integer", "minimum": 0 },
        "estimated_density": { "enum": ["LOW", "MEDIUM", "HIGH", "EXCESSIVE"] },
        "estimated_line_count": { "type": "integer", "minimum": 0 },
        "available_text_regions": { "type": "integer", "minimum": 1 },
        "typography_token_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "safe_area_fit": { "type": "boolean" },
        "max_lines_fit": { "type": "boolean" },
        "hierarchy_fit": { "type": "boolean" },
        "contrast_feasibility": { "type": "boolean" },
        "overflow_strategy": {
          "enum": [
            "REFLOW",
            "CHANGE_LAYOUT",
            "MOVE_SUPPORTING_TEXT",
            "REDUCE_DECORATION",
            "CONTENT_REVISION_REQUIRED",
            "BLOCK_AND_RETURN"
          ]
        },
        "status": { "enum": ["PASS", "WARNING", "BLOCKED"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "blocking_reason": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  }
}
