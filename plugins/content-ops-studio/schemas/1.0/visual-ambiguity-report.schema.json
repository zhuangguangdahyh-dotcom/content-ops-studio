{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/visual-ambiguity-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Visual ambiguity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "strategy_plan_id",
    "major_ambiguities",
    "blocking",
    "recommended_clarification_questions",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^VAR-[A-Z0-9-]+$" },
    "strategy_plan_id": { "type": "string", "pattern": "^DVSP-[A-Z0-9-]+$" },
    "major_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "description", "affected_decisions"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKING"] },
          "description": { "type": "string", "minLength": 1 },
          "affected_decisions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "blocking": { "type": "boolean" },
    "recommended_clarification_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 3
    },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
