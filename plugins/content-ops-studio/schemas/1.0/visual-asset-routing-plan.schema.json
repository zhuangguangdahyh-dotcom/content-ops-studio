{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/visual-asset-routing-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Visual asset routing plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routing_plan_id",
    "context_id",
    "project_id",
    "content_id",
    "routes",
    "priority_order",
    "requires_direction_candidates",
    "blocked_reasons",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "routing_plan_id": { "type": "string", "pattern": "^VARP-[A-Z0-9-]+$" },
    "context_id": { "type": "string", "pattern": "^IPC-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number",
          "asset_channel",
          "visual_mode",
          "purpose",
          "formal_text_policy",
          "requires_authorization"
        ],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "asset_channel": { "$ref": "industry-visual-pack.schema.json#/$defs/assetChannel" },
          "visual_mode": { "$ref": "common-definitions.schema.json#/$defs/visualMode" },
          "purpose": { "type": "string", "minLength": 1 },
          "formal_text_policy": { "const": "RENDERER_ONLY" },
          "requires_authorization": { "type": "boolean" }
        }
      }
    },
    "priority_order": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "type": "string", "minLength": 1 }
    },
    "requires_direction_candidates": { "type": "boolean" },
    "blocked_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
