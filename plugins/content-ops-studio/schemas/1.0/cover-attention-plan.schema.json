{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/cover-attention-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Cover attention plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "project_id",
    "content_id",
    "candidate_id",
    "page_design_intent",
    "mode",
    "primary_attention",
    "secondary_attention",
    "tertiary_attention",
    "primary_hook",
    "visual_hook",
    "visual_mass_plan",
    "scale_contrast",
    "crop_strategy",
    "grid_strategy",
    "grid_break_strategy",
    "negative_space_strategy",
    "image_type_relation",
    "color_strategy",
    "silhouette_strategy",
    "information_compression",
    "motif",
    "rationale",
    "risks",
    "runtime_browsing",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" },
    "project_id": { "type": "string", "pattern": "^(PRJ-[0-9]{8}-[A-Z0-9]{4}|CAL-[A-Z0-9-]+)$" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "page_design_intent": { "const": "COVER_ENTRY" },
    "mode": { "$ref": "#/$defs/mode" },
    "primary_attention": { "type": "string", "minLength": 1 },
    "secondary_attention": { "type": "string", "minLength": 1 },
    "tertiary_attention": { "type": "string", "minLength": 1 },
    "primary_hook": { "type": "string", "minLength": 1 },
    "visual_hook": { "type": "string", "minLength": 1 },
    "visual_mass_plan": { "type": "string", "minLength": 1 },
    "scale_contrast": { "type": "string", "minLength": 1 },
    "crop_strategy": { "type": "string", "minLength": 1 },
    "grid_strategy": { "type": "string", "minLength": 1 },
    "grid_break_strategy": { "type": "string", "minLength": 1 },
    "negative_space_strategy": { "type": "string", "minLength": 1 },
    "image_type_relation": { "type": "string", "minLength": 1 },
    "color_strategy": { "$ref": "color-attention-strategy.schema.json#/$defs/colorPlan" },
    "silhouette_strategy": { "type": "string", "minLength": 1 },
    "information_compression": { "type": "string", "minLength": 1 },
    "motif": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runtime_browsing": { "const": false },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "mode": {
      "type": "string",
      "enum": [
        "TYPE_DOMINANT",
        "IMAGE_DOMINANT",
        "TYPE_IMAGE_COLLISION",
        "CROP_DOMINANT",
        "COLOR_DOMINANT",
        "EVIDENCE_DOMINANT",
        "CONTRAST_DOMINANT",
        "HYBRID_ATTENTION"
      ]
    }
  }
}
