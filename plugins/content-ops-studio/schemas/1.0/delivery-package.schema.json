{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/delivery-package.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Delivery Package V1",
  "description": "Approved-only portable delivery inventory, separate from immutable audit history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_package_id",
    "delivery_package_version",
    "final_manifest_id",
    "final_set_fingerprint",
    "root_ref",
    "pages",
    "previews",
    "reports",
    "created_at",
    "run_id",
    "schema_version"
  ],
  "properties": {
    "delivery_package_id": { "type": "string", "pattern": "^DP-[A-Z0-9-]+$" },
    "delivery_package_version": { "const": "1.0.0" },
    "final_manifest_id": { "type": "string", "pattern": "^FINAL-[A-Z0-9-]+$" },
    "final_set_fingerprint": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "root_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "filename", "checksum"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "filename": { "type": "string", "pattern": "^[0-9]{2,3}(?:-[a-z0-9-]+)?\\.png$" },
          "checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" }
        }
      }
    },
    "previews": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["contact-sheet-full.png", "contact-sheet-310.png", "contact-sheet-186.png"]
      }
    },
    "reports": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "finalization-summary.json",
          "png-metadata-sanitization-report.json",
          "delivery-integrity-report.json"
        ]
      },
      "uniqueItems": true
    },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" }
  }
}
