{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/industry-visual-pack.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Industry visual pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "pack_version",
    "display_name",
    "supported_industries",
    "default_visual_mode_ranking",
    "asset_source_priority",
    "identity_invariants",
    "specialized_hard_blocks",
    "specialized_quality_checks",
    "consistency_requirements",
    "fallback_strategies",
    "recommended_questions",
    "prohibited_claims_or_representations",
    "allowed_overlays",
    "known_limitations",
    "contains_customer_assets",
    "schema_version"
  ],
  "properties": {
    "pack_id": { "$ref": "#/$defs/packId" },
    "pack_version": { "$ref": "#/$defs/semanticVersion" },
    "display_name": { "type": "string", "minLength": 1 },
    "supported_industries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "default_visual_mode_ranking": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common-definitions.schema.json#/$defs/visualMode" }
    },
    "asset_source_priority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assetChannel" }
    },
    "identity_invariants": { "$ref": "#/$defs/stringList" },
    "specialized_hard_blocks": { "$ref": "#/$defs/stringList" },
    "specialized_quality_checks": { "$ref": "#/$defs/stringList" },
    "consistency_requirements": { "$ref": "#/$defs/stringList" },
    "fallback_strategies": { "$ref": "#/$defs/stringList" },
    "recommended_questions": { "$ref": "#/$defs/stringList" },
    "prohibited_claims_or_representations": { "$ref": "#/$defs/stringList" },
    "allowed_overlays": {
      "type": "array",
      "items": { "$ref": "#/$defs/overlayId" },
      "uniqueItems": true
    },
    "known_limitations": { "$ref": "#/$defs/stringList" },
    "contains_customer_assets": { "const": false },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" }
  },
  "$defs": {
    "assetChannel": {
      "type": "string",
      "enum": [
        "PROJECT_ASSET",
        "AI_GENERATED_VISUAL",
        "PROGRAMMATIC_GRAPHIC",
        "EVIDENCE_ASSET",
        "PURE_TYPOGRAPHY",
        "MIXED_ASSET"
      ]
    },
    "packId": {
      "type": "string",
      "enum": [
        "GENERIC",
        "COMMERCIAL_SPACE_HOSPITALITY",
        "PROFESSIONAL_SERVICES",
        "PERSONAL_IP_CREATOR",
        "MEDICAL_AESTHETICS_HEALTH",
        "PRODUCT_CONSUMER",
        "FOOD_BEVERAGE_LIFESTYLE"
      ]
    },
    "overlayId": {
      "type": "string",
      "enum": [
        "PERSON_CONTINUITY",
        "PRODUCT_IDENTITY",
        "SPACE_IDENTITY",
        "EVIDENCE_AUTHENTICITY",
        "REGULATED_CLAIMS",
        "BEFORE_AFTER_INTEGRITY",
        "BRAND_ASSET_INTEGRITY"
      ]
    },
    "semanticVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stringList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "packBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version"],
      "properties": {
        "pack_id": { "$ref": "#/$defs/packId" },
        "pack_version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "overlayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "overlay_version"],
      "properties": {
        "overlay_id": { "$ref": "#/$defs/overlayId" },
        "overlay_version": { "$ref": "#/$defs/semanticVersion" }
      }
    }
  }
}
