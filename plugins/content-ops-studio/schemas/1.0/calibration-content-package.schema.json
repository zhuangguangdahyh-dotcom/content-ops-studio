{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-content-package.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration Content Package",
  "description": "A versioned, local-only fictional Calibration Content Package that cannot authorize Production Workspace writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "page_count",
    "pages",
    "audience",
    "painpoint",
    "content_promise",
    "content_value",
    "narrative_structure",
    "content_fingerprint",
    "quality_report_ref",
    "source_run_id",
    "version_binding",
    "status",
    "production_workspace_write_eligible",
    "imagegen_calls",
    "renderer_calls",
    "feishu_writes",
    "generated_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "package_id": { "type": "string", "pattern": "^CCP-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "page_count": { "type": "integer", "minimum": 1 },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "audience": { "type": "string", "minLength": 1 },
    "painpoint": { "type": "string", "minLength": 1 },
    "content_promise": { "type": "string", "minLength": 1 },
    "content_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "value_types"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "value_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["DECISION_VALUE", "RISK_REDUCTION", "SELF_DIAGNOSIS"] }
        }
      }
    },
    "narrative_structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "purpose"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "content_fingerprint": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "quality_report_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "source_run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "version_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "legacy", "legacy_status"],
      "properties": {
        "current": { "type": "string", "pattern": "^CV-[1-9][0-9]*:CV-[1-9][0-9]*$" },
        "legacy": { "type": "string", "minLength": 1 },
        "legacy_status": { "const": "HISTORICAL_VALID_NOT_CURRENT_FOR_CV2" }
      }
    },
    "status": { "const": "G3_PENDING" },
    "production_workspace_write_eligible": { "const": false },
    "imagegen_calls": { "const": 0 },
    "renderer_calls": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "generated_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "page_role",
        "page_intent",
        "section",
        "primary_judgment",
        "supporting_copy",
        "core_structure",
        "content_function",
        "primary_information_task",
        "negative_constraints",
        "copy_snapshot"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "page_role": { "$ref": "common-definitions.schema.json#/$defs/pageRole" },
        "page_intent": {
          "enum": ["COVER_ENTRY", "CONTENT_EDITORIAL", "DIAGNOSTIC_PAGE", "SUMMARY_PAGE"]
        },
        "section": { "type": ["string", "null"] },
        "primary_judgment": { "type": "string", "minLength": 1 },
        "supporting_copy": { "type": "string" },
        "core_structure": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "content_function": { "type": "string", "minLength": 1 },
        "primary_information_task": { "type": "string", "minLength": 1 },
        "negative_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "copy_snapshot": { "type": "string", "minLength": 1 }
      }
    }
  }
}
