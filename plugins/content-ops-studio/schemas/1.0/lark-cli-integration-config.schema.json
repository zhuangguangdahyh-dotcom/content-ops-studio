{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/lark-cli-integration-config.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Official Lark CLI integration config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binary",
    "package",
    "version",
    "version_policy",
    "identity",
    "output_format",
    "allowed_commands",
    "raw_api_policy",
    "auth_status",
    "credential_storage",
    "risk_control_status",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "binary": { "type": "string", "minLength": 1 },
    "package": { "const": "@larksuite/cli" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "version_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested", "minimum", "maximum_exclusive", "install_spec"],
      "properties": {
        "tested": { "type": "string" },
        "minimum": { "type": "string" },
        "maximum_exclusive": { "type": "string" },
        "install_spec": { "type": "string", "pattern": "^@larksuite/cli@[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "identity": { "const": "user" },
    "output_format": { "const": "json" },
    "allowed_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "raw_api_policy": { "enum": ["DISABLED", "EXACT_ALLOWLIST_ONLY"] },
    "auth_status": {
      "enum": [
        "NOT_CHECKED",
        "NOT_CONFIGURED",
        "AWAITING_USER_AUTHORIZATION",
        "AWAITING_ADMIN_APPROVAL",
        "AUTHENTICATED",
        "BLOCKED"
      ]
    },
    "credential_storage": { "const": "SYSTEM_KEYCHAIN_OWNED_BY_OFFICIAL_CLI" },
    "risk_control_status": { "const": "OFFICIAL_DEFAULT_ENFORCED" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
