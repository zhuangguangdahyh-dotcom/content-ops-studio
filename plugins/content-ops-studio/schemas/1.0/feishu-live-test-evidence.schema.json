{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/feishu-live-test-evidence.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Feishu Live Test Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "run_id",
    "provider",
    "region",
    "auth_mode",
    "test_base_title_hash",
    "test_base_identifier_hash",
    "operations_attempted",
    "operations_passed",
    "operations_failed",
    "tables_verified",
    "fields_verified",
    "relations_verified",
    "views_verified",
    "records_verified",
    "idempotent_replay_result",
    "repair_result",
    "cleanup_status",
    "manual_cleanup_required",
    "sensitive_data_redacted",
    "started_at",
    "completed_at",
    "overall_status",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^FLTE-[A-Z0-9-]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "provider": { "const": "FEISHU" },
    "region": { "const": "CHINA" },
    "auth_mode": { "const": "SELF_BUILT_TENANT_APP" },
    "test_base_title_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "test_base_identifier_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "operations_attempted": { "type": "integer", "minimum": 0 },
    "operations_passed": { "type": "integer", "minimum": 0 },
    "operations_failed": { "type": "integer", "minimum": 0 },
    "tables_verified": { "type": "integer", "minimum": 0 },
    "fields_verified": { "type": "integer", "minimum": 0 },
    "relations_verified": { "type": "integer", "minimum": 0 },
    "views_verified": { "type": "integer", "minimum": 0 },
    "records_verified": { "type": "integer", "minimum": 0 },
    "idempotent_replay_result": { "enum": ["NOT_RUN", "PASSED", "FAILED", "BLOCKED"] },
    "repair_result": { "enum": ["NOT_RUN", "PASSED", "FAILED", "BLOCKED"] },
    "cleanup_status": { "enum": ["NOT_APPLICABLE", "MANUAL_REQUIRED", "COMPLETED_MANUALLY"] },
    "manual_cleanup_required": { "type": "boolean" },
    "sensitive_data_redacted": { "const": true },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "overall_status": { "enum": ["PASSED", "FAILED", "NOT_CONFIGURED", "NOT_RUN", "BLOCKED"] },
    "schema_version": { "const": "1.0.0" },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
