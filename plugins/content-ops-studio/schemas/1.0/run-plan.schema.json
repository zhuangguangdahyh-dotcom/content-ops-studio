{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/run-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Run plan",
  "description": "Immutable workflow binding and mutable deterministic execution cursor for one run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project_id",
    "workflow_id",
    "workflow_version",
    "task_envelope",
    "runtime_mode",
    "project_snapshot_id",
    "pack_resolution_id",
    "steps",
    "current_step_id",
    "completed_step_ids",
    "failed_step_ids",
    "skipped_step_ids",
    "pending_approval",
    "capability_report",
    "idempotency_key",
    "parent_run_id",
    "resume_from_run_id",
    "plan_status",
    "created_at",
    "updated_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "workflow_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_V[1-9][0-9]*$" },
    "workflow_version": { "$ref": "common-definitions.schema.json#/$defs/semanticVersion" },
    "task_envelope": { "$ref": "task-envelope.schema.json" },
    "runtime_mode": { "type": "string", "enum": ["MOCK", "DRY_RUN", "PRODUCTION"] },
    "project_snapshot_id": { "type": "string", "pattern": "^SNAP-[A-Z0-9-]+$" },
    "pack_resolution_id": { "type": "string", "pattern": "^PRES-[A-Z0-9-]+$" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plannedStep" } },
    "current_step_id": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
    "completed_step_ids": { "$ref": "#/$defs/stepIds" },
    "failed_step_ids": { "$ref": "#/$defs/stepIds" },
    "skipped_step_ids": { "$ref": "#/$defs/stepIds" },
    "pending_approval": { "anyOf": [{ "$ref": "#/$defs/pendingApproval" }, { "type": "null" }] },
    "capability_report": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "idempotency_key": { "type": "string", "minLength": 16 },
    "parent_run_id": {
      "anyOf": [{ "$ref": "common-definitions.schema.json#/$defs/runId" }, { "type": "null" }]
    },
    "resume_from_run_id": {
      "anyOf": [{ "$ref": "common-definitions.schema.json#/$defs/runId" }, { "type": "null" }]
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "RUN_CREATED",
        "RUN_PREFLIGHT",
        "RUNNING",
        "AWAITING_APPROVAL",
        "RUN_PARTIAL",
        "RUN_BLOCKED",
        "RUN_CONFLICT",
        "RUN_FAILED",
        "RUN_CANCELLED",
        "RUN_SUCCEEDED",
        "RUN_RESUMING"
      ]
    },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "plannedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "sequence", "status", "attempts"],
      "properties": {
        "step_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "SKIPPED",
            "INVALIDATED",
            "AWAITING_APPROVAL"
          ]
        },
        "attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "stepIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "target_type", "target_id", "target_version"],
      "properties": {
        "gate": { "$ref": "common-definitions.schema.json#/$defs/approvalGate" },
        "target_type": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "target_version": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["AVAILABLE", "MOCK_ONLY", "NOT_IMPLEMENTED", "UNAVAILABLE", "BLOCKED", "UNKNOWN"]
        }
      }
    }
  }
}
