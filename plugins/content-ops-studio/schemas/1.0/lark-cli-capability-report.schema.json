{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/lark-cli-capability-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Official Lark CLI capability report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "required_commands",
    "available_commands",
    "missing_commands",
    "raw_api_fallback",
    "probed_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "status": { "enum": ["READY", "BLOCKED"] },
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "available_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "raw_api_fallback": { "enum": ["DISABLED", "EXACT_ALLOWLIST_ONLY"] },
    "probed_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
