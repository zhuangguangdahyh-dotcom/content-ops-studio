{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/feishu-reconciliation-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Feishu Reconciliation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "project_id",
    "expected_blueprint",
    "remote_snapshot",
    "matching_tables",
    "missing_tables",
    "extra_tables",
    "conflicting_tables",
    "matching_fields",
    "missing_fields",
    "renamed_fields",
    "type_conflicts",
    "extra_fields",
    "matching_views",
    "missing_views",
    "view_conflicts",
    "relation_conflicts",
    "record_conflicts",
    "orphan_candidates",
    "safe_repairs",
    "manual_decisions_required",
    "overall_status",
    "checked_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^FRR-[A-Z0-9-]+$" },
    "project_id": { "type": "string", "minLength": 1 },
    "expected_blueprint": { "type": "object", "additionalProperties": true },
    "remote_snapshot": { "type": "object", "additionalProperties": true },
    "matching_tables": { "$ref": "#/$defs/items" },
    "missing_tables": { "$ref": "#/$defs/items" },
    "extra_tables": { "$ref": "#/$defs/items" },
    "conflicting_tables": { "$ref": "#/$defs/items" },
    "matching_fields": { "$ref": "#/$defs/items" },
    "missing_fields": { "$ref": "#/$defs/items" },
    "renamed_fields": { "$ref": "#/$defs/items" },
    "type_conflicts": { "$ref": "#/$defs/items" },
    "extra_fields": { "$ref": "#/$defs/items" },
    "matching_views": { "$ref": "#/$defs/items" },
    "missing_views": { "$ref": "#/$defs/items" },
    "view_conflicts": { "$ref": "#/$defs/items" },
    "relation_conflicts": { "$ref": "#/$defs/items" },
    "record_conflicts": { "$ref": "#/$defs/items" },
    "orphan_candidates": { "$ref": "#/$defs/items" },
    "safe_repairs": { "$ref": "#/$defs/items" },
    "manual_decisions_required": { "$ref": "#/$defs/items" },
    "overall_status": {
      "enum": ["MATCH", "REPAIR_AVAILABLE", "BLOCKED", "ORPHAN_CANDIDATE", "DUPLICATE_CANDIDATES"]
    },
    "checked_at": { "type": "string", "format": "date-time" },
    "schema_version": { "const": "1.0.0" },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": { "items": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
}
