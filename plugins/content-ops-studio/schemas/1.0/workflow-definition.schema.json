{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/workflow-definition.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Workflow definition",
  "description": "Deterministic versioned workflow DAG with handlers, gates, capabilities, and recovery policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "workflow_version",
    "display_name",
    "description",
    "supported_runtime_modes",
    "task_types",
    "input_schema_id",
    "output_schema_id",
    "steps",
    "approval_gates",
    "capability_requirements",
    "terminal_conditions",
    "recovery_policy",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_V[1-9][0-9]*$" },
    "workflow_version": { "$ref": "common-definitions.schema.json#/$defs/semanticVersion" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "supported_runtime_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["MOCK", "DRY_RUN", "PRODUCTION"] }
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_schema_id": { "type": "string", "format": "uri" },
    "output_schema_id": { "type": "string", "format": "uri" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "approval_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common-definitions.schema.json#/$defs/approvalGate" }
    },
    "capability_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "terminal_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resume_verified_steps", "retry_failed_steps", "block_on_journal_corruption"],
      "properties": {
        "resume_verified_steps": { "const": false },
        "retry_failed_steps": { "const": true },
        "block_on_journal_corruption": { "const": true }
      }
    },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "sequence",
        "owner_skill",
        "handler",
        "depends_on",
        "required_capabilities",
        "input_artifacts",
        "output_artifacts",
        "state_transition",
        "idempotency_scope",
        "retry_policy",
        "checkpoint_after",
        "approval_gate",
        "failure_policy"
      ],
      "properties": {
        "step_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "owner_skill": {
          "type": "string",
          "enum": [
            "content-studio-router",
            "project-initialization",
            "painpoint-research",
            "content-creation",
            "visual-planning",
            "image-set-production",
            "content-finalization",
            "project-learning"
          ]
        },
        "handler": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "input_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "output_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "state_transition": { "type": ["string", "null"] },
        "idempotency_scope": {
          "type": "string",
          "enum": ["RUN", "PROJECT", "STEP", "APPROVAL", "RESULT"]
        },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "retry_failed_only"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "retry_failed_only": { "const": true }
          }
        },
        "checkpoint_after": { "type": "boolean" },
        "approval_gate": {
          "anyOf": [
            { "$ref": "common-definitions.schema.json#/$defs/approvalGate" },
            { "type": "null" }
          ]
        },
        "failure_policy": { "type": "string", "enum": ["BLOCK", "FAIL", "AWAIT_APPROVAL", "RETRY"] }
      }
    }
  }
}
