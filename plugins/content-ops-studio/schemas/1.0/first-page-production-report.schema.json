{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/first-page-production-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "First-page production report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first_page_production_report_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "first_page_version",
    "production_plan_ref",
    "renderer_environment_ref",
    "generation_manifest_ref",
    "render_report_ref",
    "qa_report_ref",
    "background_asset_ref",
    "rendered_asset_ref",
    "output_width",
    "output_height",
    "output_format",
    "output_checksum",
    "copy_fidelity_status",
    "layout_status",
    "safe_area_status",
    "font_status",
    "network_status",
    "ready_for_g4",
    "blocking_reasons",
    "warnings",
    "created_at",
    "run_id",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "first_page_production_report_id": { "type": "string", "pattern": "^FPPR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "first_page_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "production_plan_ref": { "type": "string", "pattern": "^projects/[A-Za-z0-9._/-]+\\.json$" },
    "renderer_environment_ref": {
      "type": "string",
      "pattern": "^projects/[A-Za-z0-9._/-]+\\.json$"
    },
    "generation_manifest_ref": {
      "type": "string",
      "pattern": "^projects/[A-Za-z0-9._/-]+\\.json$"
    },
    "render_report_ref": { "type": "string", "pattern": "^projects/[A-Za-z0-9._/-]+\\.json$" },
    "qa_report_ref": { "type": "string", "pattern": "^projects/[A-Za-z0-9._/-]+\\.json$" },
    "background_asset_ref": { "$ref": "common-definitions.schema.json#/$defs/assetReference" },
    "rendered_asset_ref": { "$ref": "common-definitions.schema.json#/$defs/assetReference" },
    "output_width": { "const": 1242 },
    "output_height": { "const": 1660 },
    "output_format": { "const": "PNG" },
    "output_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "copy_fidelity_status": { "enum": ["PASS", "FAIL"] },
    "layout_status": { "enum": ["PASS", "FAIL"] },
    "safe_area_status": { "enum": ["PASS", "FAIL"] },
    "font_status": { "enum": ["PASS", "PASS_WITH_WARNING", "FAIL"] },
    "network_status": { "enum": ["PASS_NO_ATTEMPTS", "PASS_ALL_BLOCKED", "FAIL"] },
    "ready_for_g4": { "type": "boolean" },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
