{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/runtime-diagnostic.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0; pre-release correction documented by ADR-0014",
  "title": "Runtime diagnostic",
  "description": "Truthful Runtime support, evidence, local readiness, and independent production-integration report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostic_id",
    "runtime_mode",
    "current_runtime",
    "runtime_support_policy",
    "runtime_evidence",
    "supported_runtime_match",
    "upstream_lifecycle_snapshot",
    "local_runtime_readiness",
    "production_integration_readiness",
    "cross_platform_ci_evidence",
    "project_home_status",
    "schema_status",
    "pack_status",
    "capabilities",
    "adapters",
    "git_status",
    "remote_status",
    "warnings",
    "blocking_errors",
    "overall_status",
    "checked_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "diagnostic_id": { "type": "string", "pattern": "^DIAG-[A-Z0-9-]+$" },
    "runtime_mode": { "type": "string", "enum": ["MOCK", "DRY_RUN", "PRODUCTION"] },
    "current_runtime": { "$ref": "#/$defs/currentRuntime" },
    "runtime_support_policy": { "$ref": "#/$defs/runtimePolicy" },
    "runtime_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeEvidenceSummary" }
    },
    "supported_runtime_match": { "type": "boolean" },
    "upstream_lifecycle_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycleEntry" }
    },
    "local_runtime_readiness": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "production_integration_readiness": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "cross_platform_ci_evidence": { "type": "string", "enum": ["PASSED", "FAILED", "UNVERIFIED"] },
    "project_home_status": {
      "type": "string",
      "enum": ["NOT_PROVIDED", "NOT_CREATED", "READY", "INVALID", "UNAVAILABLE"]
    },
    "schema_status": { "$ref": "#/$defs/componentStatus" },
    "pack_status": { "$ref": "#/$defs/componentStatus" },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "git_status": {
      "type": "string",
      "enum": ["COMMITTED", "UNBORN_WORKING_TREE", "DIRTY", "UNAVAILABLE"]
    },
    "remote_status": { "type": "string", "enum": ["CONFIGURED", "NOT_CONFIGURED", "UNAVAILABLE"] },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocking_errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "overall_status": { "type": "string", "enum": ["READY", "READY_WITH_WARNINGS", "BLOCKED"] },
    "checked_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "currentRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "major", "platform", "architecture"],
      "properties": {
        "name": { "const": "node" },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "major": { "type": "integer", "minimum": 0 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "runtime_name",
        "supported_range",
        "primary_major",
        "support_level"
      ],
      "properties": {
        "policy_version": { "const": "1.0.0" },
        "runtime_name": { "const": "node" },
        "supported_range": { "const": ">=24 <25" },
        "primary_major": { "const": 24 },
        "support_level": { "const": "SUPPORTED_AND_VERIFIED" }
      }
    },
    "runtimeEvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Diagnostic projection of a separately validated generic Runtime Evidence record.",
      "required": [
        "evidence_id",
        "runtime_name",
        "runtime_version",
        "runtime_major",
        "support_policy_status",
        "policy_reason_code",
        "execution_status",
        "evidence_source",
        "report_path",
        "limitations"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^RTE-[A-Z0-9-]+$" },
        "runtime_name": { "const": "node" },
        "runtime_version": {
          "type": "string",
          "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "runtime_major": { "type": "integer", "minimum": 0 },
        "support_policy_status": {
          "type": "string",
          "enum": ["SUPPORTED", "UNSUPPORTED", "UNCLAIMED", "DEPRECATED", "UPSTREAM_EOL"]
        },
        "policy_reason_code": {
          "type": "string",
          "enum": [
            "PROJECT_SUPPORTED_RUNTIME",
            "OUTSIDE_PROJECT_SUPPORT_POLICY",
            "NOT_VALIDATED_BY_THIS_PROJECT",
            "PROJECT_DEPRECATED_RUNTIME",
            "UPSTREAM_EOL"
          ]
        },
        "execution_status": {
          "type": "string",
          "enum": ["NOT_RUN", "PASSED", "FAILED", "NOT_AVAILABLE", "NOT_REQUIRED"]
        },
        "evidence_source": {
          "type": "string",
          "enum": ["LOCAL", "CI", "HISTORICAL", "POLICY", "TEST"]
        },
        "report_path": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "lifecycleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_name",
        "runtime_major",
        "upstream_status",
        "project_status",
        "execution_status"
      ],
      "properties": {
        "runtime_name": { "const": "node" },
        "runtime_major": { "type": "integer", "minimum": 0 },
        "upstream_status": {
          "type": "string",
          "enum": ["LTS", "CURRENT", "EOL", "NOT_SNAPSHOTTED"]
        },
        "project_status": {
          "type": "string",
          "enum": ["SUPPORTED", "UNSUPPORTED", "UNCLAIMED", "DEPRECATED", "UPSTREAM_EOL"]
        },
        "execution_status": {
          "type": "string",
          "enum": ["NOT_RUN", "PASSED", "FAILED", "NOT_AVAILABLE", "NOT_REQUIRED"]
        }
      }
    },
    "componentStatus": { "type": "string", "enum": ["READY", "READY_WITH_WARNINGS", "BLOCKED"] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "provider",
        "status",
        "limitations",
        "last_verified_at",
        "blocking_reason"
      ],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["AVAILABLE", "MOCK_ONLY", "NOT_IMPLEMENTED", "UNAVAILABLE", "BLOCKED", "UNKNOWN"]
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "last_verified_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
        "blocking_reason": { "type": ["string", "null"] }
      }
    }
  }
}
