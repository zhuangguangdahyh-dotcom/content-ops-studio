{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/image-text-integration-report.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Image text integration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "project_id",
    "content_id",
    "candidate_id",
    "integration_strategy",
    "image_responsibility",
    "anchor_relationships",
    "key_evidence_obscured",
    "generic_text_over_photo",
    "dimensions",
    "total_score",
    "threshold",
    "hard_blocks",
    "result",
    "operator_approval_required",
    "run_id",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^ITIR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "candidate_id": { "type": "string", "pattern": "^CCC-[A-Z0-9-]+$" },
    "integration_strategy": { "type": "string", "minLength": 1 },
    "image_responsibility": {
      "type": "string",
      "enum": [
        "INDUSTRY",
        "BUSINESS_SCENE",
        "AUDIENCE_CONTEXT",
        "PAINPOINT",
        "VALUE",
        "SUBJECT",
        "PERSON",
        "PRODUCT",
        "SPACE",
        "EVIDENCE",
        "EMOTION",
        "SEMANTIC_METAPHOR"
      ]
    },
    "anchor_relationships": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "key_evidence_obscured": { "const": false },
    "generic_text_over_photo": { "type": "boolean" },
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/dimension" }
    },
    "total_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "threshold": { "const": 85 },
    "hard_blocks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "result": { "type": "string", "enum": ["PASS_PENDING_OPERATOR", "FAIL", "BLOCKED"] },
    "operator_approval_required": { "const": true },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "weight", "score", "reason"],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "SUBJECT_OR_EDGE_RELATION",
            "NEGATIVE_SPACE_RELATION",
            "FOCUS_COOPERATION",
            "EVIDENCE_VISIBILITY",
            "READING_PATH_INTEGRATION"
          ]
        },
        "weight": { "const": 20 },
        "score": { "type": "integer", "minimum": 0, "maximum": 20 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
