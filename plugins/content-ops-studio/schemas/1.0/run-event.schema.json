{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/run-event.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Run event",
  "description": "One canonical append-only Journal event in a SHA-256 hash chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "sequence",
    "event_type",
    "run_id",
    "project_id",
    "workflow_id",
    "step_id",
    "status",
    "payload_summary",
    "artifact_refs",
    "error",
    "previous_event_hash",
    "event_hash",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^EVT-[A-Z0-9-]+$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "RUN_CREATED",
        "RUN_STARTED",
        "STEP_STARTED",
        "STEP_COMPLETED",
        "STEP_FAILED",
        "CHECKPOINT_CREATED",
        "APPROVAL_REQUESTED",
        "APPROVAL_RECORDED",
        "RUN_RESUMING",
        "LOCK_RECOVERED",
        "RUN_BLOCKED",
        "RUN_COMPLETED",
        "CORRUPTION_DETECTED"
      ]
    },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "RECORDED",
        "RUNNING",
        "SUCCESS",
        "FAILED",
        "BLOCKED",
        "AWAITING_APPROVAL",
        "CONFLICT"
      ]
    },
    "payload_summary": {
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "not": { "pattern": "(?i:token|secret|authorization|api[_-]?key|signed[_-]?url)" }
      },
      "maxProperties": 32
    },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" }
    },
    "error": { "anyOf": [{ "$ref": "error.schema.json" }, { "type": "null" }] },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^(GENESIS|[a-f0-9]{64})$"
    },
    "event_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
