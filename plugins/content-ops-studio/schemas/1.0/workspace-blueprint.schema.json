{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/workspace-blueprint.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Workspace blueprint",
  "description": "Machine-readable four-table logical workspace design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "blueprint_version",
    "provider",
    "display_name_pattern",
    "tables",
    "views",
    "status_options",
    "schema_version"
  ],
  "properties": {
    "blueprint_id": {
      "type": "string",
      "pattern": "^WBP-[A-Z0-9-]+$"
    },
    "blueprint_version": {
      "$ref": "common-definitions.schema.json#/$defs/semanticVersion"
    },
    "provider": {
      "type": "string",
      "enum": ["FEISHU"]
    },
    "display_name_pattern": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalKey",
          "displayName",
          "description",
          "primaryFieldLogicalKey",
          "fields",
          "views"
        ],
        "properties": {
          "logicalKey": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "primaryFieldLogicalKey": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "logicalKey",
                "displayName",
                "tableLogicalKey",
                "fieldType",
                "required",
                "primary",
                "hiddenByDefault",
                "systemManaged",
                "userManaged",
                "immutableAfterCreate",
                "ownerSkill",
                "defaultValue",
                "options",
                "description",
                "targetTableLogicalKey",
                "relationship",
                "bidirectional"
              ],
              "properties": {
                "logicalKey": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "tableLogicalKey": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "fieldType": {
                  "type": "string",
                  "enum": [
                    "TEXT",
                    "LONG_TEXT",
                    "NUMBER",
                    "BOOLEAN",
                    "DATE",
                    "DATETIME",
                    "SINGLE_SELECT",
                    "MULTI_SELECT",
                    "RELATION",
                    "ATTACHMENT",
                    "URL"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "primary": {
                  "type": "boolean"
                },
                "hiddenByDefault": {
                  "type": "boolean"
                },
                "systemManaged": {
                  "type": "boolean"
                },
                "userManaged": {
                  "type": "boolean"
                },
                "immutableAfterCreate": {
                  "type": "boolean"
                },
                "ownerSkill": {
                  "type": "string",
                  "minLength": 1
                },
                "defaultValue": {},
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["code", "displayName"],
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "targetTableLogicalKey": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string",
                  "enum": ["NONE", "ONE_TO_ONE", "ONE_TO_MANY", "MANY_TO_MANY"]
                },
                "bidirectional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "logicalKey",
                "displayName",
                "tableLogicalKey",
                "filterDescription",
                "sortDescription"
              ],
              "properties": {
                "logicalKey": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "tableLogicalKey": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "filterDescription": {
                  "type": "string"
                },
                "sortDescription": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalKey",
          "displayName",
          "tableLogicalKey",
          "filterDescription",
          "sortDescription"
        ],
        "properties": {
          "logicalKey": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "tableLogicalKey": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "filterDescription": {
            "type": "string"
          },
          "sortDescription": {
            "type": "string"
          }
        }
      },
      "minItems": 4
    },
    "status_options": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "displayName"],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "schema_version": {
      "$ref": "common-definitions.schema.json#/$defs/schemaVersion"
    }
  }
}
