{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/lark-cli-command.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Official Lark CLI command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "argv",
    "identity",
    "dry_run",
    "timeout_ms",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "operation": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "identity": { "enum": ["user", "bot"] },
    "dry_run": { "type": "boolean" },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
