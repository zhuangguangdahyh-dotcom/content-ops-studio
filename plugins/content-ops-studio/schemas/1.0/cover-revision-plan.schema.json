{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/cover-revision-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Cover revision plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_plan_id",
    "project_id",
    "content_id",
    "source_content_version",
    "source_copy_version",
    "source_visual_plan_version",
    "source_first_page_version",
    "source_asset_checksum",
    "revision_routes",
    "next_content_version",
    "next_copy_version",
    "next_cover_copy_version",
    "requires_new_g3",
    "preserve_source_asset",
    "negative_reference_scope",
    "next_action",
    "run_id",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "revision_plan_id": { "type": "string", "pattern": "^CRP-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "source_content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "source_copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "source_visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "source_first_page_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "source_asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "revision_routes": { "$ref": "first-page-review.schema.json#/$defs/revisionRoutes" },
    "next_content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "next_copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "next_cover_copy_version": { "type": "string", "pattern": "^CCV-[1-9][0-9]*$" },
    "requires_new_g3": { "const": true },
    "preserve_source_asset": { "const": true },
    "negative_reference_scope": { "const": "CURRENT_SET" },
    "next_action": { "const": "COVER_COPY_REVISION_REQUIRED" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
