{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-visual-direction-selection.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration visual direction selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_id",
    "candidate_set_id",
    "candidate_id",
    "candidate_checksum",
    "project_id",
    "content_id",
    "attention_mode",
    "feedback_class",
    "scope",
    "purpose",
    "selected_by",
    "formal_asset_reuse_forbidden",
    "long_term_rule_candidate",
    "creates_long_term_preference",
    "creates_g4_approval",
    "creates_style_lock",
    "next_visual_plan_version",
    "selection_comment",
    "run_id",
    "schema_version",
    "selected_at"
  ],
  "properties": {
    "selection_id": { "type": "string", "pattern": "^CVDS-[A-Z0-9-]+$" },
    "candidate_set_id": { "type": "string", "pattern": "^CCCS-[A-Z0-9-]+$" },
    "candidate_id": { "type": "string", "pattern": "^CCC-[A-Z0-9-]+$" },
    "candidate_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "attention_mode": { "const": "TYPE_DOMINANT" },
    "feedback_class": { "const": "PRODUCTION_FEEDBACK" },
    "scope": { "const": "CURRENT_SET" },
    "purpose": { "const": "CALIBRATION" },
    "selected_by": { "const": "OPERATOR" },
    "formal_asset_reuse_forbidden": { "const": true },
    "long_term_rule_candidate": { "const": false },
    "creates_long_term_preference": { "const": false },
    "creates_g4_approval": { "const": false },
    "creates_style_lock": { "const": false },
    "next_visual_plan_version": { "const": "VV-1" },
    "selection_comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "selected_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
