{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/renderer-environment-evidence.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Renderer environment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "renderer_environment_id",
    "renderer_id",
    "renderer_version",
    "node_version",
    "platform",
    "architecture",
    "playwright_version",
    "chromium_version",
    "headless_mode",
    "viewport",
    "device_scale_factor",
    "locale",
    "timezone",
    "color_scheme",
    "reduced_motion",
    "screenshot_options",
    "resolved_fonts",
    "font_profile_hash",
    "network_requests_attempted",
    "network_requests_blocked",
    "environment_fingerprint",
    "created_at",
    "run_id",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "renderer_environment_id": { "type": "string", "pattern": "^RENV-[A-Z0-9-]+$" },
    "renderer_id": { "const": "PLAYWRIGHT_HTML_CSS" },
    "renderer_version": { "const": "1.0.0" },
    "node_version": { "type": "string", "pattern": "^v24\\." },
    "platform": { "enum": ["darwin", "linux", "win32"] },
    "architecture": { "enum": ["arm64", "x64"] },
    "playwright_version": { "const": "1.62.1" },
    "chromium_version": { "type": "string", "minLength": 1 },
    "headless_mode": { "const": "HEADLESS" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "const": 1242 }, "height": { "const": 1660 } }
    },
    "device_scale_factor": { "const": 1 },
    "locale": { "const": "zh-CN" },
    "timezone": { "const": "Asia/Shanghai" },
    "color_scheme": { "const": "light" },
    "reduced_motion": { "const": "reduce" },
    "screenshot_options": { "$ref": "renderer-config.schema.json#/properties/screenshot_options" },
    "resolved_fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "family"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 }
        }
      }
    },
    "font_profile_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "network_requests_attempted": { "type": "integer", "minimum": 0 },
    "network_requests_blocked": { "type": "integer", "minimum": 0 },
    "environment_fingerprint": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
