{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/final-set-fingerprint.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Final Set Fingerprint",
  "description": "Environment-independent SHA-256 identity for an approved ordered Final Set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fingerprint_id",
    "final_manifest_id",
    "algorithm",
    "canonical_version",
    "hash",
    "inputs",
    "schema_version"
  ],
  "properties": {
    "fingerprint_id": { "type": "string", "pattern": "^FSF-[A-Z0-9-]+$" },
    "final_manifest_id": { "type": "string", "pattern": "^FINAL-[A-Z0-9-]+$" },
    "algorithm": { "const": "SHA-256" },
    "canonical_version": { "const": "1.0.0" },
    "hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "approval_ids",
        "style_lock",
        "ordered_page_checksums",
        "group_qa_ref",
        "continuity_report_ref",
        "page_count"
      ],
      "properties": {
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "copy", "visual_plan", "first_page"],
          "properties": {
            "content": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
            "copy": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
            "visual_plan": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
            "first_page": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" }
          }
        },
        "approval_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "common-definitions.schema.json#/$defs/approvalId" }
        },
        "style_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^SL-[A-Z0-9-]+$" },
            "version": { "$ref": "common-definitions.schema.json#/$defs/styleLockVersion" }
          }
        },
        "ordered_page_checksums": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common-definitions.schema.json#/$defs/sha256" }
        },
        "group_qa_ref": { "type": "string", "minLength": 1 },
        "continuity_report_ref": { "type": "string", "minLength": 1 },
        "page_count": { "type": "integer", "minimum": 1 }
      }
    },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" }
  }
}
