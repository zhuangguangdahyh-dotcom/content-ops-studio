{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-cover-revision.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration cover revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "project_id",
    "content_id",
    "source_review_request_id",
    "source_cover_version",
    "source_asset_id",
    "source_asset_checksum",
    "decision",
    "revision_classification",
    "defect_code",
    "source_disposition",
    "source_preserved",
    "target_cover_version",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "attention_mode",
    "creates_preference",
    "creates_style_lock",
    "remaining_pages_created",
    "feishu_writes",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "revision_id": { "type": "string", "pattern": "^CCR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "source_review_request_id": { "type": "string", "pattern": "^CFRR-[A-Z0-9-]+$" },
    "source_cover_version": { "const": "FPV-1" },
    "source_asset_id": { "$ref": "common-definitions.schema.json#/$defs/assetId" },
    "source_asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "decision": { "const": "REVISE" },
    "revision_classification": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["RENDER_ONLY", "PAGE_COMPOSITION"] },
      "allOf": [
        { "contains": { "const": "RENDER_ONLY" } },
        { "contains": { "const": "PAGE_COMPOSITION" } }
      ]
    },
    "defect_code": { "const": "TEXT_BACKGROUND_LOCAL_CONTRAST_FAILURE" },
    "source_disposition": { "const": "QUALITY_DEFECT_REFERENCE" },
    "source_preserved": { "const": true },
    "target_cover_version": { "const": "FPV-2" },
    "content_version": { "const": "CV-1" },
    "copy_version": { "const": "CV-1" },
    "visual_plan_version": { "const": "VV-1" },
    "attention_mode": { "const": "TYPE_DOMINANT" },
    "creates_preference": { "const": false },
    "creates_style_lock": { "const": false },
    "remaining_pages_created": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
