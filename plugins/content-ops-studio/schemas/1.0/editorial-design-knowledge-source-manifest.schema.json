{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/editorial-design-knowledge-source-manifest.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Editorial design knowledge source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "knowledge_version",
    "runtime_browsing",
    "sources",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "manifest_id": { "type": "string", "pattern": "^EDKSM-[A-Z0-9-]+$" },
    "knowledge_version": { "const": "1.0.0" },
    "runtime_browsing": { "const": false },
    "sources": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/source" } },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "organization",
        "title",
        "url",
        "domain",
        "verified_at",
        "principles_derived",
        "limitations"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^EDKS-[A-Z0-9-]+$" },
        "organization": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "domain": { "type": "string", "minLength": 3 },
        "verified_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
        "principles_derived": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "editorial-design-knowledge-layer.schema.json#/$defs/principle" }
        },
        "limitations": { "type": "string", "minLength": 20, "maxLength": 800 }
      }
    }
  }
}
