{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-g4-approval-v2.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration G4 approval V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_evidence_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "first_page_version",
    "asset_id",
    "asset_checksum",
    "g3_approval_id",
    "g3_approval_ref",
    "g3_approval_hash",
    "current_version_qa_binding_id",
    "g4_review_request_ref",
    "g4_review_request_hash",
    "decision",
    "status",
    "approval_event",
    "style_lock_authorized",
    "remaining_page_production_eligibility",
    "renderer_calls",
    "imagegen_calls",
    "feishu_writes",
    "production_workspace_write_eligible",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "approval_evidence_id": { "type": "string", "pattern": "^CG4A2-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "first_page_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "asset_id": { "$ref": "common-definitions.schema.json#/$defs/assetId" },
    "asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "g3_approval_id": { "type": "string", "pattern": "^APR-[A-Z0-9-]+$" },
    "g3_approval_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "g3_approval_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "current_version_qa_binding_id": { "type": "string", "pattern": "^CVQA-[A-Z0-9-]+$" },
    "g4_review_request_ref": {
      "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
    },
    "g4_review_request_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "decision": { "const": "APPROVE" },
    "status": { "const": "PASSED" },
    "approval_event": { "$ref": "approval-event.schema.json" },
    "style_lock_authorized": { "const": true },
    "remaining_page_production_eligibility": { "const": "ELIGIBLE" },
    "renderer_calls": { "const": 0 },
    "imagegen_calls": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "production_workspace_write_eligible": { "const": false },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
