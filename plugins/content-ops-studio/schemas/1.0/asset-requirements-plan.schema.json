{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/asset-requirements-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Asset requirements plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_requirements_plan_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "pages",
    "global_asset_rules",
    "shared_assets",
    "unresolved_assets",
    "generation_required_count",
    "programmatic_graphic_count",
    "project_asset_count",
    "evidence_asset_count",
    "no_asset_count",
    "ready_for_first_page",
    "created_at",
    "run_id",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "asset_requirements_plan_id": { "type": "string", "pattern": "^ARP-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "global_asset_rules": { "$ref": "#/$defs/textList" },
    "shared_assets": { "$ref": "#/$defs/textList" },
    "unresolved_assets": { "$ref": "#/$defs/textList" },
    "generation_required_count": { "type": "integer", "minimum": 0 },
    "programmatic_graphic_count": { "type": "integer", "minimum": 0 },
    "project_asset_count": { "type": "integer", "minimum": 0 },
    "evidence_asset_count": { "type": "integer", "minimum": 0 },
    "no_asset_count": { "type": "integer", "minimum": 0 },
    "ready_for_first_page": { "type": "boolean" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "strategy": {
      "enum": [
        "PROJECT_ASSET",
        "USER_REFERENCE",
        "HISTORICAL_STYLE",
        "EVIDENCE_SCREENSHOT",
        "GENERATED_BACKGROUND",
        "PROGRAMMATIC_GRAPHIC",
        "LICENSED_ASSET",
        "NO_BACKGROUND_ASSET"
      ]
    },
    "textList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "uniqueItems": true
    },
    "nullableText": { "type": ["string", "null"], "maxLength": 1200 },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "page_role",
        "asset_source_strategy",
        "asset_purpose",
        "asset_description",
        "required_assets",
        "optional_assets",
        "reference_asset_ids",
        "generation_required",
        "programmatic_render_required",
        "evidence_asset_required",
        "aspect_ratio",
        "composition",
        "subject",
        "environment",
        "camera_direction",
        "lighting_direction",
        "material_direction",
        "prohibited_content",
        "informational_text_in_background_allowed",
        "fallback_strategy"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1, "maximum": 20 },
        "page_role": { "$ref": "common-definitions.schema.json#/$defs/pageRole" },
        "asset_source_strategy": { "$ref": "#/$defs/strategy" },
        "asset_purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "asset_description": { "type": "string", "maxLength": 2000 },
        "required_assets": { "$ref": "#/$defs/textList" },
        "optional_assets": { "$ref": "#/$defs/textList" },
        "reference_asset_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^VREF-[A-Z0-9-]+$" },
          "uniqueItems": true
        },
        "generation_required": { "type": "boolean" },
        "programmatic_render_required": { "type": "boolean" },
        "evidence_asset_required": { "type": "boolean" },
        "aspect_ratio": { "const": "3:4" },
        "composition": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/nullableText" },
        "environment": { "$ref": "#/$defs/nullableText" },
        "camera_direction": { "$ref": "#/$defs/nullableText" },
        "lighting_direction": { "$ref": "#/$defs/nullableText" },
        "material_direction": { "$ref": "#/$defs/nullableText" },
        "prohibited_content": { "$ref": "#/$defs/textList" },
        "informational_text_in_background_allowed": { "const": false },
        "fallback_strategy": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
