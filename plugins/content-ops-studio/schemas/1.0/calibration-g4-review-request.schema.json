{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-g4-review-request.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration G4 review request for a rebound first page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_request_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "first_page_version",
    "asset_id",
    "asset_checksum",
    "content_package_ref",
    "content_package_hash",
    "g3_approval_id",
    "g3_approval_ref",
    "visual_plan_ref",
    "visual_plan_hash",
    "first_page_manifest_ref",
    "first_page_manifest_hash",
    "current_version_qa_binding_id",
    "gate",
    "status",
    "decision",
    "approval_event_created",
    "style_lock_created",
    "remaining_pages_created",
    "imagegen_calls",
    "renderer_calls",
    "feishu_writes",
    "production_workspace_write_eligible",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "review_request_id": { "type": "string", "pattern": "^CGRR-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "first_page_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "asset_id": { "$ref": "common-definitions.schema.json#/$defs/assetId" },
    "asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "content_package_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "content_package_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "g3_approval_id": { "type": "string", "pattern": "^APR-[A-Z0-9-]+$" },
    "g3_approval_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "visual_plan_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "visual_plan_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "first_page_manifest_ref": {
      "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
    },
    "first_page_manifest_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "current_version_qa_binding_id": { "type": "string", "pattern": "^CVQA-[A-Z0-9-]+$" },
    "gate": { "const": "CALIBRATION_G4" },
    "status": { "const": "AWAITING_USER_APPROVAL" },
    "decision": { "const": "PENDING_OPERATOR" },
    "approval_event_created": { "const": false },
    "style_lock_created": { "const": false },
    "remaining_pages_created": { "const": 0 },
    "imagegen_calls": { "const": 0 },
    "renderer_calls": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "production_workspace_write_eligible": { "const": false },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
