{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-style-lock-preview.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration style-lock preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_id",
    "project_id",
    "content_id",
    "source_asset_id",
    "source_asset_checksum",
    "status",
    "cover_locked_rules",
    "group_shared_rules",
    "content_page_allowed_variations",
    "creates_style_lock",
    "creates_project_preference",
    "creates_industry_rule",
    "creates_global_preference",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "preview_id": { "type": "string", "pattern": "^CSLP-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "source_asset_id": { "$ref": "common-definitions.schema.json#/$defs/assetId" },
    "source_asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "status": { "const": "PREVIEW_ONLY_PENDING_G4" },
    "cover_locked_rules": { "$ref": "#/$defs/rules" },
    "group_shared_rules": { "$ref": "#/$defs/rules" },
    "content_page_allowed_variations": { "$ref": "#/$defs/rules" },
    "creates_style_lock": { "const": false },
    "creates_project_preference": { "const": false },
    "creates_industry_rule": { "const": false },
    "creates_global_preference": { "const": false },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
