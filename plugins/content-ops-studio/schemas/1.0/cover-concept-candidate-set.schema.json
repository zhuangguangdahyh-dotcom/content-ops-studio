{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/cover-concept-candidate-set.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Cover concept candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_set_id",
    "project_id",
    "content_id",
    "account_goal",
    "status",
    "candidates",
    "full_contact_sheet_ref",
    "thumbnail_310_contact_sheet_ref",
    "thumbnail_186_contact_sheet_ref",
    "material_difference_verified",
    "formal_fpv_count",
    "g4_count",
    "style_lock_count",
    "feishu_write_count",
    "run_id",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "candidate_set_id": { "type": "string", "pattern": "^CCCS-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "account_goal": { "$ref": "cover-conversion-plan.schema.json#/$defs/accountGoal" },
    "status": { "const": "AWAITING_USER_SELECTION" },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "full_contact_sheet_ref": {
      "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
    },
    "thumbnail_310_contact_sheet_ref": {
      "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
    },
    "thumbnail_186_contact_sheet_ref": {
      "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
    },
    "material_difference_verified": { "const": true },
    "formal_fpv_count": { "const": 0 },
    "g4_count": { "const": 0 },
    "style_lock_count": { "const": 0 },
    "feishu_write_count": { "const": 0 },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "cover_copy_package_id",
        "cover_primary_hook",
        "cover_secondary_line",
        "conversion_strategy",
        "cover_objective",
        "asset_channel",
        "visual_mode",
        "background_semantic_role",
        "composition_summary",
        "text_to_image_ratio",
        "full_preview_ref",
        "thumbnail_310_ref",
        "thumbnail_186_ref",
        "click_clarity_report_id",
        "semantic_relevance_report_id",
        "image_quality_report_id",
        "click_clarity_score",
        "semantic_relevance_score",
        "image_quality_score",
        "hard_blocks",
        "main_strength",
        "main_risk",
        "host_imagegen",
        "renderer"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^CCC-[A-Z0-9-]+$" },
        "cover_copy_package_id": { "type": "string", "pattern": "^CCPK-[A-Z0-9-]+$" },
        "cover_primary_hook": { "type": "string", "minLength": 1 },
        "cover_secondary_line": { "type": "string" },
        "conversion_strategy": {
          "$ref": "cover-conversion-plan.schema.json#/$defs/conversionStrategy"
        },
        "cover_objective": { "$ref": "cover-conversion-plan.schema.json#/$defs/coverObjective" },
        "asset_channel": { "$ref": "industry-visual-pack.schema.json#/$defs/assetChannel" },
        "visual_mode": { "$ref": "common-definitions.schema.json#/$defs/visualMode" },
        "background_semantic_role": {
          "$ref": "visual-semantic-relevance-report.schema.json#/$defs/semanticRole"
        },
        "composition_summary": { "type": "string", "minLength": 1 },
        "text_to_image_ratio": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
        "full_preview_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
        "thumbnail_310_ref": {
          "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
        },
        "thumbnail_186_ref": {
          "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath"
        },
        "click_clarity_report_id": { "type": "string", "pattern": "^CCCR-[A-Z0-9-]+$" },
        "semantic_relevance_report_id": { "type": "string", "pattern": "^VSRR-[A-Z0-9-]+$" },
        "image_quality_report_id": { "type": "string", "pattern": "^IQR-[A-Z0-9-]+$" },
        "click_clarity_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "semantic_relevance_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "image_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "hard_blocks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 0
        },
        "main_strength": { "type": "string", "minLength": 1 },
        "main_risk": { "type": "string", "minLength": 1 },
        "host_imagegen": { "type": "boolean" },
        "renderer": { "const": true }
      }
    }
  }
}
