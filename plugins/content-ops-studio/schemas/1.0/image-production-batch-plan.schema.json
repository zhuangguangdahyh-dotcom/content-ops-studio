{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/image-production-batch-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Image production batch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_plan_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "style_lock_version",
    "final_page_count",
    "source_asset_count",
    "direction_candidate_count",
    "formal_candidate_count",
    "generation_attempt_count",
    "failed_attempt_count",
    "retained_history_count",
    "pages",
    "requires_g4",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "batch_plan_id": { "type": "string", "pattern": "^IPBP-[A-Z0-9-]+$" },
    "project_id": { "$ref": "common-definitions.schema.json#/$defs/projectId" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "style_lock_version": {
      "anyOf": [
        { "$ref": "common-definitions.schema.json#/$defs/styleLockVersion" },
        { "type": "null" }
      ]
    },
    "final_page_count": { "type": "integer", "minimum": 1 },
    "source_asset_count": { "type": "integer", "minimum": 0 },
    "direction_candidate_count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "formal_candidate_count": { "type": "integer", "minimum": 0 },
    "generation_attempt_count": { "type": "integer", "minimum": 0 },
    "failed_attempt_count": { "type": "integer", "minimum": 0 },
    "retained_history_count": { "type": "integer", "minimum": 0 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "asset_channel", "status"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "asset_channel": { "$ref": "industry-visual-pack.schema.json#/$defs/assetChannel" },
          "status": { "type": "string", "enum": ["BLOCKED_BY_G4", "ELIGIBLE", "PLANNED"] }
        }
      }
    },
    "requires_g4": { "type": "boolean" },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
