{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-g3-approval.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration G3 approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_evidence_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "page_count",
    "content_package_id",
    "content_package_ref",
    "content_package_hash",
    "content_fingerprint",
    "quality_report_ref",
    "quality_report_hash",
    "review_request_ref",
    "review_request_hash",
    "reviewed_source_run_id",
    "decision",
    "status",
    "approval_event",
    "visual_rebinding_authorized",
    "production_workspace_write_eligible",
    "feishu_writes",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "approval_evidence_id": { "type": "string", "pattern": "^CG3A-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "page_count": { "const": 6 },
    "content_package_id": { "type": "string", "pattern": "^CCP-[A-Z0-9-]+$" },
    "content_package_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "content_package_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "content_fingerprint": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "quality_report_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "quality_report_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "review_request_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "review_request_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "reviewed_source_run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "decision": { "const": "APPROVE" },
    "status": { "const": "PASSED" },
    "approval_event": { "$ref": "approval-event.schema.json" },
    "visual_rebinding_authorized": { "const": true },
    "production_workspace_write_eligible": { "const": false },
    "feishu_writes": { "const": 0 },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
