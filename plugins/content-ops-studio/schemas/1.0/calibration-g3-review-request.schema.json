{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-g3-review-request.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration G3 Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_request_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "page_count",
    "content_package_ref",
    "content_package_hash",
    "content_fingerprint",
    "quality_report_ref",
    "quality_score",
    "blocking_failures",
    "source_run_id",
    "status",
    "decision",
    "approval_created",
    "legacy_chain",
    "new_visual_plan",
    "new_first_page",
    "new_g4",
    "slv2",
    "remaining_pages",
    "imagegen_calls",
    "renderer_calls",
    "feishu_writes",
    "production_workspace_write_eligible",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "review_request_id": { "type": "string", "pattern": "^CG3R-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "page_count": { "type": "integer", "minimum": 1 },
    "content_package_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "content_package_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "content_fingerprint": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "quality_report_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "blocking_failures": { "type": "array", "maxItems": 0 },
    "source_run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "status": { "const": "AWAITING_USER_APPROVAL" },
    "decision": { "const": "PENDING_OPERATOR" },
    "approval_created": { "const": false },
    "legacy_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "status"],
      "properties": {
        "binding": { "const": "CV-1 / CV-1 / VV-1 / FPV-2 / APR-20260826-G4A1 / SLV-1" },
        "status": { "const": "PRESERVED_VALID_FOR_CV1_ONLY" }
      }
    },
    "new_visual_plan": { "const": "NOT_CREATED" },
    "new_first_page": { "const": "NOT_CREATED" },
    "new_g4": { "const": "NOT_CREATED" },
    "slv2": { "const": "NOT_CREATED" },
    "remaining_pages": { "const": 0 },
    "imagegen_calls": { "const": 0 },
    "renderer_calls": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "production_workspace_write_eligible": { "const": false },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  }
}
