{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-visual-plan.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration visual plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_plan_id",
    "project_ref",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "page_count",
    "content_package_ref",
    "content_package_hash",
    "g3_approval_id",
    "g3_approval_ref",
    "g3_approval_hash",
    "audience",
    "painpoint",
    "content_value",
    "narrative",
    "calibration_systems",
    "historical_style_reference",
    "active_style_lock_for_current_version",
    "pages",
    "status",
    "remaining_pages_created",
    "imagegen_calls",
    "renderer_calls",
    "feishu_writes",
    "production_workspace_write_eligible",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "visual_plan_id": { "type": "string", "pattern": "^CVP-[A-Z0-9-]+$" },
    "project_ref": { "$ref": "project-reference.schema.json" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "page_count": { "const": 6 },
    "content_package_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "content_package_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "g3_approval_id": { "type": "string", "pattern": "^APR-[A-Z0-9-]+$" },
    "g3_approval_ref": { "$ref": "common-definitions.schema.json#/$defs/relativeProjectPath" },
    "g3_approval_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "audience": { "type": "string", "minLength": 1 },
    "painpoint": { "type": "string", "minLength": 1 },
    "content_value": { "type": "string", "minLength": 1 },
    "narrative": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "calibration_systems": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNIVERSAL_VISUAL_CALIBRATION_V1",
          "EDITORIAL_DESIGN_KNOWLEDGE_V1",
          "COVER_ATTENTION_INTELLIGENCE_V1",
          "TYPOGRAPHY_SPATIAL_INTEGRITY_V1",
          "TYPOGRAPHY_BREATHING_ROOM_V1",
          "RASTER_TEXT_BACKGROUND_CONTRAST_INTEGRITY_V1"
        ]
      }
    },
    "historical_style_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_lock_version", "usage"],
      "properties": {
        "style_lock_version": { "const": "SLV-1" },
        "usage": { "const": "HISTORICAL_CALIBRATION_STYLE_REFERENCE" }
      }
    },
    "active_style_lock_for_current_version": { "type": "null" },
    "pages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/pagePlan" }
    },
    "status": { "const": "CREATED" },
    "remaining_pages_created": { "const": 0 },
    "imagegen_calls": { "const": 0 },
    "renderer_calls": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "production_workspace_write_eligible": { "const": false },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "pagePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "page_role",
        "page_intent",
        "copy_hash",
        "visual_purpose",
        "composition_family",
        "asset_strategy",
        "typography_role",
        "production_status"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1, "maximum": 6 },
        "page_role": { "$ref": "common-definitions.schema.json#/$defs/pageRole" },
        "page_intent": {
          "enum": ["COVER_ENTRY", "CONTENT_EDITORIAL", "DIAGNOSTIC_PAGE", "SUMMARY_PAGE"]
        },
        "copy_hash": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
        "visual_purpose": { "type": "string", "minLength": 1 },
        "composition_family": { "type": "string", "minLength": 1 },
        "asset_strategy": { "enum": ["REUSED_VERIFIED_ASSET", "PLANNED_NOT_PRODUCED"] },
        "typography_role": { "type": "string", "minLength": 1 },
        "production_status": { "enum": ["PENDING_G4_REVIEW", "NOT_CREATED"] }
      }
    }
  }
}
