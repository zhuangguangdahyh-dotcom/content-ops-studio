{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/first-page-review.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "First-page review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first_page_review_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "first_page_version",
    "asset_checksum",
    "decision",
    "overall_comment",
    "layout_feedback",
    "typography_feedback",
    "color_feedback",
    "hierarchy_feedback",
    "graphic_feedback",
    "copy_feedback",
    "requested_changes",
    "revision_classification",
    "reviewer_role",
    "source_run_id",
    "created_at",
    "schema_version",
    "extensions"
  ],
  "properties": {
    "first_page_review_id": { "type": "string", "pattern": "^FPR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "first_page_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "decision": { "enum": ["APPROVE", "REVISE", "REJECT", "PAUSE"] },
    "overall_comment": { "type": "string", "maxLength": 2000 },
    "layout_feedback": { "type": "string", "maxLength": 1000 },
    "typography_feedback": { "type": "string", "maxLength": 1000 },
    "color_feedback": { "type": "string", "maxLength": 1000 },
    "hierarchy_feedback": { "type": "string", "maxLength": 1000 },
    "graphic_feedback": { "type": "string", "maxLength": 1000 },
    "copy_feedback": { "type": "string", "maxLength": 1000 },
    "requested_changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "maxItems": 20
    },
    "revision_classification": {
      "enum": ["NONE", "RENDER_ONLY", "PAGE_VISUAL_PLAN", "GLOBAL_VISUAL_PLAN", "CONTENT_COPY"]
    },
    "revision_routes": { "$ref": "#/$defs/revisionRoutes" },
    "reviewer_role": { "const": "OPERATOR" },
    "source_run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "extensions": { "$ref": "common-definitions.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "revisionRoutes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["RENDER_ONLY", "PAGE_VISUAL_PLAN", "GLOBAL_VISUAL_DIRECTION", "CONTENT_COPY"]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "APPROVE" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "requested_changes": { "type": "array", "maxItems": 0 },
          "revision_classification": { "const": "NONE" }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "REVISE" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "requested_changes": { "type": "array", "minItems": 1 },
          "revision_classification": { "not": { "const": "NONE" } }
        }
      }
    }
  ]
}
