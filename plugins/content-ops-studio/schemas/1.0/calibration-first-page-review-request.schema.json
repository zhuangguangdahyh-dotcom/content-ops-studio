{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-ops-studio.local/schemas/1.0/calibration-first-page-review-request.schema.json",
  "$comment": "contract-version: 1.0.0; schema-version: 1.0.0",
  "title": "Calibration first-page review request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_request_id",
    "project_id",
    "content_id",
    "content_version",
    "copy_version",
    "visual_plan_version",
    "calibration_cover_version",
    "asset_id",
    "asset_checksum",
    "gate",
    "status",
    "decision",
    "reviewer_role",
    "approval_event_created",
    "style_lock_created",
    "remaining_pages_created",
    "feishu_writes",
    "run_id",
    "schema_version",
    "created_at"
  ],
  "properties": {
    "review_request_id": { "type": "string", "pattern": "^CFRR-[A-Z0-9-]+$" },
    "project_id": { "$ref": "cover-conversion-plan.schema.json#/$defs/projectRef" },
    "content_id": { "$ref": "common-definitions.schema.json#/$defs/contentId" },
    "content_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "copy_version": { "$ref": "common-definitions.schema.json#/$defs/contentVersion" },
    "visual_plan_version": { "$ref": "common-definitions.schema.json#/$defs/visualVersion" },
    "calibration_cover_version": { "type": "string", "pattern": "^FPV-[1-9][0-9]*$" },
    "asset_id": { "$ref": "common-definitions.schema.json#/$defs/assetId" },
    "asset_checksum": { "$ref": "common-definitions.schema.json#/$defs/sha256" },
    "gate": { "const": "CALIBRATION_G4" },
    "status": { "const": "AWAITING_USER_APPROVAL" },
    "decision": { "const": "PENDING_OPERATOR" },
    "reviewer_role": { "const": "OPERATOR" },
    "approval_event_created": { "const": false },
    "style_lock_created": { "const": false },
    "remaining_pages_created": { "const": 0 },
    "feishu_writes": { "const": 0 },
    "run_id": { "$ref": "common-definitions.schema.json#/$defs/runId" },
    "schema_version": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "created_at": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  }
}
